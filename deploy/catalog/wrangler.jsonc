{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "dynamic-shopper-catalog",
	"main": "worker.ts",
	"compatibility_date": "2026-11-21",
	"workers_dev": true,
	"assets": {
		"directory": "./dist/assets",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
		"not_found_handling": "none"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dynamic-shopper",
			"database_id": "0098249a-09f0-405d-ab80-0a970d478011"
		}
	]
}
