{
	"name": "my-app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:d1": "DEPLOY_TARGET=cloudflare vite build && node scripts/check-worker-build.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:d1:local": "wrangler d1 migrations apply DB --local",
		"db:d1:remote": "wrangler d1 migrations apply DB --remote",
		"dev:d1": "bun run build:d1 && wrangler dev",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"dev:shopping": "vite --config preview/vite.config.ts",
		"dev:catalog": "node scripts/catalog-server.ts --port 4190",
		"catalog:import": "node scripts/catalog-server.ts --import data/shopee/catalog.json",
		"catalog:export:d1": "node scripts/export-catalog-d1.ts",
		"build:catalog:cloud": "vite build --config preview/vite.config.ts && node deploy/catalog/prepare.ts",
		"catalog:import:d1": "wrangler d1 execute DB --config deploy/catalog/wrangler.jsonc --remote --file data/shopee/catalog-d1.sql",
		"deploy:catalog": "npm run build:catalog:cloud && wrangler deploy --config deploy/catalog/wrangler.jsonc",
		"verify:catalog": "node scripts/verify-catalog-deployment.ts",
		"dev:shopping:cloud": "CATALOG_API_ORIGIN=https://dynamic-shopper-catalog.nattawin-ya.workers.dev vite --config preview/vite.config.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261121.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-cloudflare": "^9.0.0",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.0",
		"auth": "^1.7.25",
		"better-auth": "^1.7.25",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.166.0"
	},
	"dependencies": {
		"better-sqlite3": "^13.2.0",
		"openai": "^7.62.0",
		"zod": "^4.6.7"
	}
}
